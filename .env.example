# ==============================================================================
# MEDICOMPARE INDIA — ENVIRONMENT CONFIGURATION
# File: .env.example
# Governance: AGENTS.md, Rule 03 (Zero Secret Exposure to Public Clients)
# ==============================================================================

# Public Supabase API Endpoint & Anon Client Key
# (Safe for Next.js browser client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Supabase Service Role Key
# (STRICTLY RESTRICTED to server-side Route Handlers - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Default Application Port & URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

